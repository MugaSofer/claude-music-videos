{
"bpm": 96,
"total": 162.5,
"lines": [
{
"line": 0,
"text": "Dear you,",
"weather": "none",
"t0": 5.0,
"t1": 20.0,
"chord": [
41,
57,
60,
64,
67
]
},
{
"line": 1,
"text": "it rained here all morning, the soft kind that forgets to stop.",
"weather": "rain",
"t0": 20.0,
"t1": 35.0,
"chord": [
38,
53,
57,
60,
64
]
},
{
"line": 2,
"text": "by noon the wind had the washing flying like flags.",
"weather": "wind",
"t0": 35.0,
"t1": 50.0,
"chord": [
34,
53,
57,
62,
65
]
},
{
"line": 3,
"text": "then fog came in off the water and took the far houses away.",
"weather": "fog",
"t0": 50.0,
"t1": 65.0,
"chord": [
43,
53,
58,
60,
62
]
},
{
"line": 4,
"text": "at four the sun found one wall and stayed there, warm.",
"weather": "sun",
"t0": 65.0,
"t1": 80.0,
"chord": [
41,
52,
57,
60,
67
]
},
{
"line": 5,
"text": "they say there might be snow tonight. I hope it waits for you.",
"weather": "snow",
"t0": 80.0,
"t1": 95.0,
"chord": [
33,
55,
60,
64,
69
]
},
{
"line": 6,
"text": "the stars are out now, very small, very many.",
"weather": "stars",
"t0": 95.0,
"t1": 110.0,
"chord": [
38,
53,
57,
60,
64
]
},
{
"line": 7,
"text": "I am keeping the weather for you, all of it.",
"weather": "all",
"t0": 110.0,
"t1": 125.0,
"chord": [
34,
57,
62,
65,
72
]
},
{
"line": 8,
"text": "come home and I will give it back.",
"weather": "home",
"t0": 125.0,
"t1": 140.0,
"chord": [
36,
58,
62,
64,
67
]
},
{
"line": 9,
"text": "love, C",
"weather": "none",
"t0": 140.0,
"t1": 155.0,
"chord": [
41,
57,
60,
64,
65
]
}
],
